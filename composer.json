{
    "name": "packstub/filament-account-switcher",
    "description": "Switch between accounts in Filament: impersonate users, linked sub-accounts, and developer logins.",
    "keywords": [
        "packstub",
        "laravel",
        "filament-account-switcher",
        "filament-impersonate"
    ],
    "homepage": "https://github.com/packstub/filament-account-switcher",
    "support": {
        "issues": "https://github.com/packstub/filament-account-switcher/issues",
        "source": "https://github.com/packstub/filament-account-switcher"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "filament/filament": "^5.0|^4.0",
        "illuminate/contracts": "^12.0|^11.0|^10.0|^9.0",
        "lab404/laravel-impersonate": "^1.7",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.8",
        "nunomaduro/larastan": "^3.9",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "XliteDev\\FilamentImpersonate\\": "src/",
            "XliteDev\\FilamentImpersonate\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XliteDev\\FilamentImpersonate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XliteDev\\FilamentImpersonate\\FilamentImpersonateServiceProvider"
            ],
            "aliases": {
                "FilamentImpersonate": "XliteDev\\FilamentImpersonate\\Facades\\FilamentImpersonate"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
